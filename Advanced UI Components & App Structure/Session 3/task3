3.Build a Flipkart-style product list using ListView.separated, where each product card shows product name and price, and group the products visually by category
using a thicker divider and a category label above each group.Use a combination of ListView.separated and conditional logic in separatorBuilder to insert a 
category label and thicker divider when the category changes.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(home: ProductScreen()));
}

class ProductScreen extends StatelessWidget {
  List<Map<String, dynamic>> products = [
    {"name": "Shirt", "price": 599, "category": "Fashion"},
    {"name": "Jeans", "price": 999, "category": "Fashion"},
    {"name": "Shoes", "price": 1499, "category": "Fashion"},
    {"name": "Mobile", "price": 15000, "category": "Electronics"},
    {"name": "Laptop", "price": 45000, "category": "Electronics"},
    {"name": "Headphones", "price": 999, "category": "Electronics"},
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Flipkart Products")),
      body: ListView.builder(
        itemCount: products.length,
        itemBuilder: (context, index) {
          bool newCategory = index == 0 ||
              products[index]["category"] !=
              products[index - 1]["category"];

          return Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (newCategory)
                Container(
                  width: double.infinity,
                  color: Colors.blue.shade100,
                  padding: EdgeInsets.all(10),
                  child: Text(
                    products[index]["category"],
                    style: TextStyle(
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),

              ListTile(
                title: Text(products[index]["name"]),
                subtitle: Text(
                  "Price: ₹${products[index]["price"]}",
                ),
              ),

              Divider(thickness: 2),
            ],
          );
        },
      ),
    );
  }
}
