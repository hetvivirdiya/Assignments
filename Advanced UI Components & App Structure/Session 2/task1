1.Convert a vertical list of food categories (like Zomato: Pizza, Biryani, Burger, Desserts, Chinese, South Indian) into a GridView.count in Flutter, displaying
each category as a card with an icon and a title.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(home: MyApp()));
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Food Categories")),
      body: GridView.count(
        crossAxisCount: 2,
        children: [
          Card(child: Column(
            children: [Icon(Icons.local_pizza), Text("Pizza")],
          )),
          Card(child: Column(
            children: [Icon(Icons.restaurant), Text("Biryani")],
          )),
          Card(child: Column(
            children: [Icon(Icons.lunch_dining), Text("Burger")],
          )),
          Card(child: Column(
            children: [Icon(Icons.cake), Text("Desserts")],
          )),
          Card(child: Column(
            children: [Icon(Icons.ramen_dining), Text("Chinese")],
          )),
          Card(child: Column(
            children: [Icon(Icons.rice_bowl), Text("South Indian")],
          )),
        ],
      ),
    );
  }
}
