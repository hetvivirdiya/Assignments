5.Refactor your PlaylistScreen to use a DefaultTabController with a dynamic list of tab names (e.g., ['Favourites', 'Trending', 'Downloaded']) so you can easily add 
or remove tabs by changing the list.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(home: PlaylistScreen()));
}

class PlaylistScreen extends StatelessWidget {

  List<String> tabs = [
    "Favourites",
    "Trending",
    "Downloaded"
  ];

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: tabs.length,
      child: Scaffold(
        appBar: AppBar(
          title: Text("Music App"),

          bottom: TabBar(
            isScrollable: true,
            tabs: tabs.map((name) {
              return Tab(text: name);
            }).toList(),
          ),
        ),

        body: TabBarView(
          children: tabs.map((name) {
            return Center(
              child: Text(
                name,
                style: TextStyle(fontSize: 25),
              ),
            );
          }).toList(),
        ),
      ),
    );
  }
}
