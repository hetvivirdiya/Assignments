3.Add a third tab to PlaylistScreen called 'Recently Played' and display a different icon on each tab using the Tab widget's icon property.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(home: PlaylistScreen()));
}

class PlaylistScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          title: Text("Music App"),

          bottom: TabBar(
            tabs: [
              Tab(
                icon: Icon(Icons.playlist_play),
                text: "Playlists",
              ),
              Tab(
                icon: Icon(Icons.favorite),
                text: "Liked Songs",
              ),
              Tab(
                icon: Icon(Icons.history),
                text: "Recently Played",
              ),
            ],
          ),
        ),

        body: TabBarView(
          children: [
            Center(child: Text("My Playlists")),
            Center(child: Text("Liked Songs")),
            Center(child: Text("Recently Played")),
          ],
        ),
      ),
    );
  }
}
