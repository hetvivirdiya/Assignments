import 'package:flutter/material.dart';

void main() {
  runApp(const MaterialApp(
    debugShowCheckedModeBanner: false,
    home: PlaylistVoting(),
  ));
}

class PlaylistVoting extends StatefulWidget {
  const PlaylistVoting({super.key});

  @override
  State<PlaylistVoting> createState() => _PlaylistVotingState();
}

class _PlaylistVotingState extends State<PlaylistVoting> {
  int voteCount = 0;

  // Separate method containing setState()
  void updateVote(int change) {
    setState(() {
      voteCount += change;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Playlist Voting'),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              Icons.music_note,
              size: 80,
              color: Colors.blue,
            ),

            const SizedBox(height: 15),

            const Text(
              'Perfect - Ed Sheeran',
              style: TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 20),

            Text(
              'Vote Count: $voteCount',
              style: const TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 25),

            Row(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                ElevatedButton(
                  onPressed: () {
                    updateVote(1);
                  },
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.green,
                    foregroundColor: Colors.white,
                  ),
                  child: const Text('Upvote'),
                ),

                const SizedBox(width: 15),

                ElevatedButton(
                  onPressed: () {
                    updateVote(-1);
                  },
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.red,
                    foregroundColor: Colors.white,
                  ),
                  child: const Text('Downvote'),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}
