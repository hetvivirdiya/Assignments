2.Build a simple Flipkart-style product card using StatelessWidget that shows a product image, name, and price. Change the product name and price by
editing the code, then hot reload to see the update.


import 'package:flutter/material.dart';

class ProductCard extends StatelessWidget {
  const ProductCard({super.key});

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 4,
      margin: const EdgeInsets.all(16),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Image.network(
            'https://picsum.photos/200',
            height: 150,
            width: double.infinity,
            fit: BoxFit.cover,
          ),
          const Padding(
            padding: EdgeInsets.all(8),
            child: Text(
              'Wireless Headphones',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
          const Text(
            '₹1,499',
            style: TextStyle(
              fontSize: 20,
              color: Colors.green,
            ),
          ),
          const SizedBox(height: 12),
        ],
      ),
    );
  }
}

void main() {
  runApp(const MaterialApp(
    home: Scaffold(
      appBar: AppBar(title: const Text('Product Store')),
      body: ProductCard(),
    ),
  ));
}
