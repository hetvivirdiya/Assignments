1.Create a new Flutter app and replace the default home screen with a Scaffold containing a Column that displays two Text widgets 
showing your favorite food and favorite IPL team.

import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(
    home: Scaffold(
      appBar: AppBar(
        title: Text("My Favorites"),
      ),
      body: Column(
        children: [
          Text("My Favorite Food: Pizza"),
          Text("My Favorite IPL Team: Mumbai Indians"),
        ],
      ),
    ),
  ));
}
