2.Create a simple Flutter app that displays your name and favorite food on the home screen, then run the app on your physical device using the 'flutter run' command.

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: const Text('My Flutter App'),
        ),
        body: const Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                'My name is Alex',
                style: TextStyle(fontSize: 24),
              ),
              SizedBox(height: 20),
              Text(
                'My favorite food is Pizza',
                style: TextStyle(fontSize: 20),
              ),
            ],
          ),
        ),
      ),
    );
  }
}


Then run:
    flutter run
