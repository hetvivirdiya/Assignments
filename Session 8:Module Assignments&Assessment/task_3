3.Add a new Dart file called user_profile.dart in the lib folder and define a UserProfile class with properties: username (String), followers (int), and
bio (String). Create an instance of UserProfile in main.dart and print the username in the debug console.

lib/user_profile.dart:--

class UserProfile {
  String username;
  int followers;
  String bio;

  UserProfile({
    required this.username,
    required this.followers,
    required this.bio,
  });
}

main.dart:--


import 'package:flutter/material.dart';
import 'user_profile.dart';

void main() {
  UserProfile user = UserProfile(
    username: 'john_doe',
    followers: 1500,
    bio: 'Flutter developer',
  );

  debugPrint(user.username);

  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Mini Instagram',
      home: Scaffold(
        appBar: AppBar(
          title: const Text('Mini Instagram'),
        ),
        body: const Center(
          child: Text('Welcome to Mini Instagram!'),
        ),
      ),
    );
  }
}

