2.Build a simple layout for a Zomato-style food listing screen using Column and Row widgets: show the restaurant name, a 'Like' button, and a 'Book Table' button 
side by side.


import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(
    home: Scaffold(
      appBar: AppBar(title: Text("Food Listing")),
      body: Column(
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            children: [
              Text("Pizza Palace"),
              ElevatedButton(
                onPressed: () {},
                child: Text("Like"),
              ),
              ElevatedButton(
                onPressed: () {},
                child: Text("Book Table"),
              ),
            ],
          ),
        ],
      ),
    ),
  ));
}
