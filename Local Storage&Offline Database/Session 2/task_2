2.<p>Make login status persistent in `study_planner`: save `loggedIn` with `setBool` under the key `logged_in` whenever the Log in / Log out button is pressed, and 
load it in `main()` before `runApp`. Test: log in, stop and run again (still logged in), then log out, stop and run again ('Please log in' appears). Constraint: Do 
not read SharedPreferences inside `build()`.</p>

1. lib/app_settings.dart
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

class AppSettings extends ChangeNotifier {
  bool darkMode;
  bool loggedIn;

  AppSettings({
    required this.darkMode,
    required this.loggedIn,
  });

  // Dark mode
  Future<void> toggleDarkMode(bool value) async {
    darkMode = value;

    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool('dark_mode', value);

    notifyListeners();
  }

  // Login / Logout
  Future<void> toggleLogin() async {
    loggedIn = !loggedIn;

    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool('logged_in', loggedIn);

    notifyListeners();
  }
}

2. lib/main.dart
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'app_settings.dart';
import 'study_planner_app.dart';

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();

  final prefs = await SharedPreferences.getInstance();

  final darkMode = prefs.getBool('dark_mode') ?? false;
  final loggedIn = prefs.getBool('logged_in') ?? false;

  runApp(
    ChangeNotifierProvider(
      create: (_) => AppSettings(
        darkMode: darkMode,
        loggedIn: loggedIn,
      ),
      child: const StudyPlannerApp(),
    ),
  );
}

