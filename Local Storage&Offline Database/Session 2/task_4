import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import 'app_settings.dart';

class SettingsScreen extends StatefulWidget {
  const SettingsScreen({super.key});

  @override
  State<SettingsScreen> createState() => _SettingsScreenState();
}

class _SettingsScreenState extends State<SettingsScreen> {
  late TextEditingController nameController;

  @override
  void initState() {
    super.initState();

    nameController = TextEditingController(
      text: context.read<AppSettings>().studentName,
    );
  }

  @override
  void dispose() {
    nameController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final settings = context.watch<AppSettings>();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Settings'),
      ),

      body: ListView(
        padding: const EdgeInsets.all(16),

        children: [
          // Login / Logout
          ElevatedButton(
            onPressed: settings.toggleLogin,
            child: Text(
              settings.loggedIn ? 'Log out' : 'Log in',
            ),
          ),

          const SizedBox(height: 20),

          // Dark Mode
          SwitchListTile(
            title: const Text('Dark Mode'),
            value: settings.darkMode,
            onChanged: settings.toggleDarkMode,
          ),

          const SizedBox(height: 20),

          // Your name
          const Text(
            'Your name',
            style: TextStyle(
              fontSize: 18,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 10),

          TextField(
            controller: nameController,
            decoration: const InputDecoration(
              hintText: 'Enter your name',
              border: OutlineInputBorder(),
            ),
          ),

          const SizedBox(height: 10),

          // Save button
          ElevatedButton(
            onPressed: () async {
              await settings.saveName(nameController.text);

              if (!context.mounted) return;

              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(
                  content: Text('Name saved'),
                ),
              );
            },
            child: const Text('Save'),
          ),

          const SizedBox(height: 30),

          // Reset preferences button
          OutlinedButton(
            onPressed: () async {
              await settings.resetPreferences();

              nameController.clear();

              if (!context.mounted) return;

              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(
                  content: Text('Preferences reset successfully'),
                ),
              );
            },
            child: const Text('Reset preferences'),
          ),
        ],
      ),
    );
  }
}

